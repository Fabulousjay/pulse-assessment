// Pulse — coordination store only. Nothing here is durable user data:
// rows are deleted on leave, on staleness, or after a signal is delivered.
// Chat text and video are NOT modeled — they ride WebRTC peer-to-peer and
// never reach the server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Presence {
  id       String   @id // client-generated session uuid
  secret   String? // server-generated; proves ownership of this session's row
  lat      Float // ALREADY privacy-offset coords (raw is never stored)
  lng      Float
  busy     Boolean  @default(false) // true while in an active connection
  lastSeen DateTime

  @@index([lastSeen])
}

model Signal {
  // Mailbox for connection requests + WebRTC signaling only.
  id        String   @id @default(uuid())
  toId      String // recipient session id
  fromId    String // sender session id
  type      String // request | accept | decline | offer | answer | ice | end
  payload   String? // JSON string (SDP / ICE candidate)
  createdAt DateTime @default(now())

  @@index([toId])
}

// Live Pulse — a single ephemeral group room that appears when enough
// people are online at once. Everything here is transient: the room, its
// members, and its messages are all deleted once expiresAt passes.
model PulseRoom {
  id        String   @id @default(uuid())
  prompt    String // the shared icebreaker question for this room
  createdAt DateTime @default(now())
  expiresAt DateTime // server-enforced; access is refused past this time

  @@index([expiresAt])
}

model PulseRoomMember {
  id        String   @id @default(uuid())
  roomId    String
  sessionId String // links to Presence.id, but never exposed to other members
  color     String // anonymous per-room identity, e.g. "Blue"
  joinedAt  DateTime @default(now())

  @@unique([roomId, sessionId])
  @@index([roomId])
}

model PulseMessage {
  id        String   @id @default(uuid())
  roomId    String
  color     String // the sender's anonymous color, NOT their sessionId
  body      String
  createdAt DateTime @default(now())

  @@index([roomId])
}